# Porta do servidor gRPC (recebe os streams e heartbeats dos agentes em Rust)
GRPC_PORT=50051

# Porta do servidor HTTP / WebSocket (fornece dados e relatórios ao Frontend / Painel do Técnico)
HTTP_PORT=8081

# String de conexão com o banco PostgreSQL (mesmo banco da API principal)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/servicedesk?sslmode=disable

# Janela de tolerância sem sinal antes de classificar uma estação como offline (segundos)
HEARTBEAT_TIMEOUT_SECS=12

# Origem permitida para CORS na API HTTP/WebSocket
ALLOWED_ORIGIN=*
