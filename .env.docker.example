# ==============================================================================
# ServiceDesk On-Premise - Configurações do Docker Compose
# ==============================================================================

# Versão das imagens
VERSION=1.0.0

# Porta externa do PostgreSQL no Host (padrão: 5432)
POSTGRES_PORT=5432

# Credenciais do Banco de Dados
POSTGRES_DB=servicedesk
POSTGRES_USER=postgres
POSTGRES_PASSWORD=servicedesk_secret_2026

# Chave secreta JWT (Recomenda-se gerar uma chave aleatória de 64 caracteres em produção)
JWT_SECRET=7b6d05c497fdcc72ed0ddf4796568e50379b8e7fe64ddaebb8dfb26f184eb850

# Tempo de expiração do Token de Acesso em minutos (480 = 8 horas)
ACCESS_TOKEN_TTL_MIN=480

# Origens permitidas para CORS (use * para permitir qualquer IP/porta da rede interna)
ALLOWED_ORIGIN=*
