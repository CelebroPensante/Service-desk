# Porta gRPC local do agente (para consulta imediata pelo App Desktop / Tauri na mesma máquina)
AGENT_LOCAL_ADDR=0.0.0.0:3000

# Endereço gRPC do Servidor Coordenador On-Premise em Go
SERVER_GO_GRPC_URL=http://127.0.0.1:50051

# Intervalos de coleta e sinalização (em segundos)
TELEMETRY_INTERVAL_SECS=2
HEARTBEAT_INTERVAL_SECS=5
TOP_PROCESSES_LIMIT=5

# Opcional: identificador fixo da máquina (se vazio, usa hostname + SO)
MACHINE_UID=

# Controle opcional. Vídeo usa WebRTC no navegador; esta conexão executa entrada nativa.
REMOTE_CONTROL_ENABLED=false
SERVER_GO_REMOTE_WS_URL=ws://127.0.0.1:8081/api/remoto/agente/ws
